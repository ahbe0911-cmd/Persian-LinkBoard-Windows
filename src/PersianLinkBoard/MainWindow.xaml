<Window x:Class="PersianLinkBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="لینک‌برد فارسی" Height="760" Width="1240" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#121D31" BorderBrush="#263754" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="62" Height="62" CornerRadius="18" Background="#6C7CFF" HorizontalAlignment="Right">
                        <TextBlock Text="↗" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="لینک‌برد فارسی" FontSize="24" FontWeight="Bold" Margin="0,14,0,4"/>
                    <TextBlock Text="دسترسی سریع به لینک‌های کاربردی" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="خانه" HorizontalContentAlignment="Right" Background="#263654"/>
                    <Button Content="دسته‌بندی‌ها" HorizontalContentAlignment="Right"/>
                    <Button Content="تنظیمات" HorizontalContentAlignment="Right" Click="Settings_Click"/>
                    <Button Content="درباره برنامه" HorizontalContentAlignment="Right" Click="About_Click"/>
                </StackPanel>

                <Border Grid.Row="4" CornerRadius="18" Background="#172640" Padding="14">
                    <StackPanel>
                        <TextBlock Text="میانبرهای شما" FontWeight="Bold"/>
                        <TextBlock x:Name="CountText" Text="۰ لینک" Margin="0,6,0,0" Foreground="#9EAAFF"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="سلام! 👋" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="همه لینک‌های مهمت یک‌جا و مرتب" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                    <TextBlock x:Name="ClockText" Text="--:--:--" FontSize="24" FontWeight="Bold" TextAlignment="Left" FlowDirection="LeftToRight"/>
                    <TextBlock x:Name="DateText" Text="----/--/--" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextAlignment="Left" FlowDirection="LeftToRight"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="44" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="جستجو در عنوان، آدرس و دسته‌بندی"/>
                <Button Grid.Column="1" Content="+ افزودن لینک" Margin="12,0,0,0" Background="{StaticResource AccentBrush}" Click="AddLink_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="LinksControl" ItemsSource="{Binding LinksView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="250" MinHeight="176" Margin="0,0,14,14" Padding="18" Background="{StaticResource CardBrush}" CornerRadius="20" BorderBrush="#2B3B5A" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Background="#2E4064" CornerRadius="9" Padding="8,4">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#C9D0FF"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Url}" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" TextAlignment="Left"/>
                                    <TextBlock Grid.Row="2" Text="برای باز کردن، روی دکمه ورود بزن" Margin="0,14,0,14" Foreground="#71809B" FontSize="11"/>
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="باز کردن" Tag="{Binding}" Background="#5061E9" Click="OpenLink_Click"/>
                                        <Button Grid.Column="1" Content="ویرایش" Tag="{Binding}" Click="EditLink_Click"/>
                                        <Button Grid.Column="2" Content="حذف" Tag="{Binding}" Background="#6A3040" Click="DeleteLink_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
