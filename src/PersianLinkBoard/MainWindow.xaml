<Window x:Class="PersianLinkBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="لینک‌برد فارسی" Height="760" Width="1240" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" FlowDirection="RightToLeft">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#121D31" BorderBrush="#263754" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="58" Height="58" CornerRadius="17" Background="#6C7CFF" HorizontalAlignment="Right">
                        <TextBlock Text="↗" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="لینک‌برد فارسی" FontSize="23" FontWeight="Bold" Margin="0,13,0,4"/>
                    <TextBlock Text="لینک‌های مهم، همیشه دم دست" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="⌂  خانه" HorizontalContentAlignment="Right" Background="#263654"/>
                    <Button Content="▦  دسته‌بندی‌ها" HorizontalContentAlignment="Right" Click="Categories_Click"/>
                    <Button Content="⚙  تنظیمات" HorizontalContentAlignment="Right" Click="Settings_Click"/>
                    <Button Content="ⓘ  درباره برنامه" HorizontalContentAlignment="Right" Click="About_Click"/>
                </StackPanel>

                <Border Grid.Row="4" CornerRadius="18" Background="#172640" Padding="14">
                    <StackPanel>
                        <TextBlock Text="آمار سریع" FontWeight="Bold"/>
                        <TextBlock x:Name="CountText" Text="۰ لینک" Margin="0,6,0,0" Foreground="#9EAAFF"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="سلام! 👋" FontSize="29" FontWeight="Bold"/>
                    <TextBlock Text="همه لینک‌های کاربردی در یک برد مرتب" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#16243C" CornerRadius="14" Padding="16,9">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock x:Name="ClockText" Text="--:--:--" FontSize="22" FontWeight="Bold" TextAlignment="Left" FlowDirection="LeftToRight"/>
                        <TextBlock x:Name="DateText" Text="----/--/--" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextAlignment="Left" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="43" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="جستجو در عنوان، آدرس و دسته‌بندی"/>
                <Button Grid.Column="1" Content="+ افزودن لینک" Margin="12,0,0,0" Background="{StaticResource AccentBrush}" Click="AddLink_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="LinksControl" ItemsSource="{Binding LinksView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="236" MinHeight="154" Margin="0,0,12,12" Padding="15" Background="{StaticResource CardBrush}" CornerRadius="18" BorderBrush="#2B3B5A" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Background="#2E4064" CornerRadius="9" Padding="8,4">
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#C9D0FF"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Url}" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" TextAlignment="Left"/>
                                    <Button Grid.Row="2" Content="باز کردن لینک" Tag="{Binding}" Background="#5061E9" Margin="0,12,0,8" Click="OpenLink_Click"/>
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="ویرایش" Tag="{Binding}" Padding="8,5" Margin="0,0,5,0" Click="EditLink_Click"/>
                                        <Button Grid.Column="1" Content="حذف" Tag="{Binding}" Padding="8,5" Margin="0,0,5,0" Background="#6A3040" Click="DeleteLink_Click"/>
                                        <Button Grid.Column="2" Content="↑" Tag="{Binding}" Width="30" Padding="4" Margin="0,0,5,0" ToolTip="انتقال به بالا" Click="MoveUp_Click"/>
                                        <Button Grid.Column="3" Content="↓" Tag="{Binding}" Width="30" Padding="4" ToolTip="انتقال به پایین" Click="MoveDown_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
