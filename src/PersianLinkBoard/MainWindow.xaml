<Window x:Class="PersianLinkBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="لینک‌برد فارسی" Height="800" Width="1280" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowGradient}"
        FlowDirection="RightToLeft" FontFamily="{StaticResource PersianFont}">
    <Window.Resources>
        <Style x:Key="SideButton" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Background" Value="#221B2943"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style x:Key="MiniIconButton" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="24" Background="#B00E1728" BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource AccentGradient}">
                            <TextBlock Text="↗" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,2,0,0">
                            <TextBlock Text="LinkBoard" FontSize="19" FontWeight="Bold" FlowDirection="LeftToRight" TextAlignment="Right"/>
                            <TextBlock Text="لینک‌برد فارسی" FontSize="10" Foreground="#91A0B7"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="دسترسی سریع به لینک‌های پرکاربرد" FontSize="10" Foreground="#7E8DA4" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource SideButton}" Content="⌂   خانه" Background="#563D4F80"/>
                    <Button Style="{StaticResource SideButton}" Content="▦   دسته‌بندی‌ها" Click="Categories_Click"/>
                    <Button Style="{StaticResource SideButton}" Content="💾   پشتیبان‌گیری" Click="Backup_Click"/>
                    <Button Style="{StaticResource SideButton}" Content="↺   بازیابی" Click="Restore_Click"/>
                    <Button Style="{StaticResource SideButton}" Content="⚙   تنظیمات" Click="Settings_Click"/>
                    <Button Style="{StaticResource SideButton}" Content="ⓘ   درباره برنامه" Click="About_Click"/>
                </StackPanel>

                <Border Grid.Row="4" CornerRadius="17" Background="#281B2A44" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock Text="خلاصه" FontSize="11" Foreground="#A9B5C9"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock x:Name="CountText" Text="۰ لینک" FontSize="15" FontWeight="Bold" Foreground="#B8C0FF"/><TextBlock Text="لینک" FontSize="9" Foreground="#738198"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock x:Name="PinnedCountText" Text="۰ پین" FontSize="15" FontWeight="Bold" Foreground="#FFD68C"/><TextBlock Text="پین" FontSize="9" Foreground="#738198"/></StackPanel>
                        </Grid>
                        <TextBlock x:Name="CategoryCountText" Text="۰ دسته" FontSize="10" Foreground="#7ADBC7" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2" CornerRadius="25" Background="#A0101829" BorderBrush="#2CFFFFFF" BorderThickness="1" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="لینک‌های کاربردی" FontSize="27" FontWeight="Bold"/>
                        <TextBlock Text="سریع، مرتب و بدون شلوغی" Foreground="#8D9BB0" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="15" Background="#241D2B45" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="13,7">
                        <StackPanel>
                            <TextBlock x:Name="ClockText" Text="--:--:--" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight" TextAlignment="Left"/>
                            <TextBlock x:Name="DateText" Text="----/--/--" FontSize="10" Foreground="#8291A8" FlowDirection="LeftToRight" TextAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Height="42" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="جستجو در عنوان، آدرس و دسته‌بندی"/>
                    <ComboBox x:Name="CategoryFilter" Grid.Column="1" Height="42" Margin="10,0,0,0" VerticalContentAlignment="Center" SelectionChanged="CategoryFilter_SelectionChanged"/>
                    <Button Grid.Column="2" Content="+ افزودن لینک" Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0" Click="AddLink_Click"/>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="14" Background="#24192840" Padding="11" Margin="0,0,5,0"><StackPanel><TextBlock Text="کل لینک‌ها" FontSize="9" Foreground="#7D8AA1"/><TextBlock x:Name="DashboardLinksText" Text="0" FontSize="19" FontWeight="Bold"/></StackPanel></Border>
                    <Border Grid.Column="1" CornerRadius="14" Background="#24192840" Padding="11" Margin="2,0,3,0"><StackPanel><TextBlock Text="دسته‌ها" FontSize="9" Foreground="#7D8AA1"/><TextBlock x:Name="DashboardCategoriesText" Text="0" FontSize="19" FontWeight="Bold"/></StackPanel></Border>
                    <Border Grid.Column="2" CornerRadius="14" Background="#24192840" Padding="11" Margin="3,0,2,0"><StackPanel><TextBlock Text="پین‌شده" FontSize="9" Foreground="#7D8AA1"/><TextBlock x:Name="DashboardPinnedText" Text="0" FontSize="19" FontWeight="Bold"/></StackPanel></Border>
                    <Border Grid.Column="3" CornerRadius="14" Background="#24192840" Padding="11" Margin="5,0,0,0"><StackPanel><TextBlock Text="چیدمان" FontSize="9" Foreground="#7D8AA1"/><TextBlock x:Name="LayoutModeText" Text="استاندارد" FontSize="15" FontWeight="Bold"/></StackPanel></Border>
                </Grid>

                <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                    <ItemsControl x:Name="LinksControl" ItemsSource="{Binding LinksView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        MinHeight="158" Margin="0,0,10,10" Padding="12" CornerRadius="16"
                                        Background="#381A2841" BorderBrush="#24FFFFFF" BorderThickness="1"
                                        Tag="{Binding}" AllowDrop="True"
                                        PreviewMouseLeftButtonDown="Card_MouseLeftButtonDown"
                                        PreviewMouseMove="Card_MouseMove" Drop="Card_Drop">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="11" Background="#405C66FF">
                                                <TextBlock Text="{Binding DisplayInitial}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,6,0">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding HostName}" FontSize="9" Foreground="#7F8EA5" FlowDirection="LeftToRight" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource MiniIconButton}" Content="{Binding PinGlyph}" Tag="{Binding}" Click="PinLink_Click" ToolTip="پین"/>
                                        </Grid>

                                        <Border Grid.Row="1" Background="#24172437" CornerRadius="8" Padding="7,3" Margin="0,9,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#BAC5FF"/>
                                        </Border>

                                        <Button Grid.Row="2" Content="باز کردن" Tag="{Binding}" Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,7" Padding="8,5" Click="OpenLink_Click"/>

                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Content="ویرایش" Tag="{Binding}" Margin="0,0,4,0" Padding="7,4" Click="EditLink_Click"/>
                                            <Button Grid.Column="1" Content="حذف" Tag="{Binding}" Margin="4,0,0,0" Padding="7,4" Background="#4831263A" Click="DeleteLink_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
