<Window x:Class="PersianLinkBoard.LinkEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ویرایش لینک" Width="560" Height="560" MinWidth="520" MinHeight="520"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowGradient}" FlowDirection="RightToLeft"
        ShowInTaskbar="False" FontFamily="{StaticResource PersianFont}">
    <Grid Margin="18">
        <Border CornerRadius="24" Background="#C0121A2D" BorderBrush="#34FFFFFF" BorderThickness="1" Padding="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Width="52" Height="52" HorizontalAlignment="Right" CornerRadius="16" Background="{StaticResource AccentGradient}" Margin="0,0,0,14">
                        <TextBlock Text="↗" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="27" FontWeight="Bold"/>
                    </Border>

                    <TextBlock x:Name="HeadingText" Text="افزودن لینک جدید" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="عنوان، آدرس و دسته‌بندی را وارد کنید." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22" FontSize="12"/>

                    <TextBlock Text="عنوان لینک" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox x:Name="TitleBox" Height="46" VerticalContentAlignment="Center" MaxLength="80" Margin="0,0,0,16"/>

                    <TextBlock Text="آدرس سایت" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox x:Name="UrlBox" Height="46" VerticalContentAlignment="Center" FlowDirection="LeftToRight" TextAlignment="Left" Margin="0,0,0,16"/>

                    <TextBlock Text="دسته‌بندی" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBox x:Name="CategoryBox" Height="46" VerticalContentAlignment="Center" MaxLength="40" Margin="0,0,0,16"/>

                    <Border x:Name="ErrorBorder" Background="#50371E2B" BorderBrush="#8C4057" BorderThickness="1" CornerRadius="12" Padding="11" Visibility="Collapsed" Margin="0,0,0,16">
                        <TextBlock x:Name="ErrorText" Foreground="#FFD2DC" TextWrapping="Wrap"/>
                    </Border>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="انصراف" Margin="0,0,6,0" Height="44" Click="Cancel_Click"/>
                        <Button Grid.Column="1" Content="ذخیره لینک" Margin="6,0,0,0" Height="44" Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
